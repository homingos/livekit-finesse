{
  "name": "@flamai/livekit-plugin-finesse",
  "version": "0.1.1",
  "description": "Finesse text-to-speech for LiveKit Agents (Node.js): realtime speech in 60 languages, including 22 Indian languages, with your cloned voices.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homingos/livekit-finesse.git"
  },
  "homepage": "https://github.com/homingos/livekit-finesse#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "finesse",
    "flam",
    "livekit",
    "livekit-agents",
    "tts",
    "text-to-speech",
    "voice-agents",
    "realtime"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/live/**'",
    "test:live": "FINESSE_LIVE=1 vitest run tests/live",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@types/ws": "^8.5.12",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@livekit/agents": "^1.9.4",
    "@livekit/rtc-node": "^1.1.0"
  },
  "devDependencies": {
    "@livekit/agents": "1.9.4",
    "@livekit/rtc-node": "^1.2.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.15.1",
  "publishConfig": {
    "access": "public"
  }
}
